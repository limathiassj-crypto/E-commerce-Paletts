# Copie para .env.local e preencha com os dados do app web do seu projeto Firebase
# (Console Firebase > Configurações do projeto > Seus apps > Config do SDK).
# Estas chaves são identificadores públicos do app; a segurança vem das Security Rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Região das Cloud Functions (padrão southamerica-east1)
VITE_FUNCTIONS_REGION=southamerica-east1
